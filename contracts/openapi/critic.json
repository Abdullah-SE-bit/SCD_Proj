{
  "openapi": "3.1.0",
  "info": {
    "title": "M12 critic",
    "version": "0.1.0",
    "description": "Proposed contract from Guide section 3. Not implemented."
  },
  "paths": {
    "/check": {
      "post": {
        "summary": "Claims with evidence ids in; supported or not per claim",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "claim_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "supported": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "claim_id",
                          "supported"
                        ],
                        "description": "Inputs documented in Guide section 3: supported or not, per claim; property names are proposed."
                      }
                    }
                  },
                  "required": [
                    "results"
                  ],
                  "description": "Inputs documented in Guide section 3; property names are proposed."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claims": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "claim_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "text": {
                          "type": "string",
                          "minLength": 1
                        },
                        "evidence_ids": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "claim_id",
                        "text",
                        "evidence_ids"
                      ],
                      "description": "Inputs documented in Guide section 3: claims with evidence ids; property names are proposed."
                    }
                  }
                },
                "required": [
                  "claims"
                ],
                "description": "Inputs documented in Guide section 3; property names are proposed."
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Process alive",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Can serve now, dependencies reachable",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          },
          "503": {
            "description": "Alive but cannot serve now"
          }
        }
      }
    }
  }
}
