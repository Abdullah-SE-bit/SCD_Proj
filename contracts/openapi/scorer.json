{
  "openapi": "3.1.0",
  "info": {
    "title": "M10 scoring model",
    "version": "0.1.0",
    "description": "Proposed contract from Guide section 3. Not implemented."
  },
  "paths": {
    "/score": {
      "post": {
        "summary": "Rubric, idea, evidence in; dimension score out",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/dimension-score.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "rubric": {
                    "$ref": "../schemas/rubric.schema.json"
                  },
                  "idea": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "items": {
                      "$ref": "../schemas/evidence-item.schema.json"
                    }
                  }
                },
                "required": [
                  "rubric",
                  "idea",
                  "evidence"
                ],
                "description": "Inputs documented in Guide section 3: rubric, idea, evidence; property names are proposed."
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Process alive",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Can serve now, dependencies reachable",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          },
          "503": {
            "description": "Alive but cannot serve now"
          }
        }
      }
    }
  }
}
