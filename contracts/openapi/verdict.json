{
  "openapi": "3.1.0",
  "info": {
    "title": "M11 verdict engine",
    "version": "0.1.0",
    "description": "Proposed contract from Guide section 3. Not implemented."
  },
  "paths": {
    "/verdict": {
      "post": {
        "summary": "Six scores, profile, config in; verdict out",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/verdict.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scores": {
                    "type": "array",
                    "items": {
                      "$ref": "../schemas/dimension-score.schema.json"
                    },
                    "maxItems": 6
                  },
                  "profile": {
                    "$ref": "../schemas/student-profile.schema.json"
                  },
                  "config": {
                    "type": "object"
                  }
                },
                "required": [
                  "scores",
                  "profile",
                  "config"
                ],
                "description": "Inputs documented in Guide section 3: six scores, profile, config (an abstaining scorer sends no record, AMB-09); property names are proposed."
              }
            }
          }
        }
      }
    },
    "/whatif": {
      "post": {
        "summary": "What-if computation",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/verdict.schema.json"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "scores": {
                    "type": "array",
                    "items": {
                      "$ref": "../schemas/dimension-score.schema.json"
                    },
                    "maxItems": 6
                  },
                  "profile": {
                    "$ref": "../schemas/student-profile.schema.json"
                  },
                  "config": {
                    "type": "object"
                  }
                },
                "required": [
                  "scores",
                  "profile",
                  "config"
                ],
                "description": "Inputs documented in Guide section 3: six scores, profile, config (an abstaining scorer sends no record, AMB-09); property names are proposed."
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Process alive",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Can serve now, dependencies reachable",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "x-status": "proposed: fields not specified by the course documents"
                }
              }
            }
          },
          "503": {
            "description": "Alive but cannot serve now"
          }
        }
      }
    }
  }
}
