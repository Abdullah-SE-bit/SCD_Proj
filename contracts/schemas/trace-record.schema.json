{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Trace record (M13)",
  "description": "Source: Guide 2.3. Listed fields are the documented minimum (Guide section 1).",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "integer",
      "minimum": 0
    },
    "parent_step": {
      "type": [
        "integer",
        "null"
      ]
    },
    "agent": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "tool_call",
        "llm_call",
        "decision"
      ]
    },
    "tool": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {},
    "output": {},
    "tokens_in": {
      "type": "integer",
      "minimum": 0
    },
    "tokens_out": {
      "type": "integer",
      "minimum": 0
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0
    },
    "retries": {
      "type": "integer",
      "minimum": 0
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "cache_hit": {
      "type": "boolean"
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "ts": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "run_id",
    "step_id",
    "parent_step",
    "agent",
    "kind",
    "tool",
    "input",
    "output",
    "tokens_in",
    "tokens_out",
    "cost_usd",
    "latency_ms",
    "retries",
    "model",
    "cache_hit",
    "error",
    "ts"
  ]
}
