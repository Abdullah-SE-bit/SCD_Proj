{
  "dimension": "learning",
  "version": 1,
  "scale": "0-5",
  "note": "Version 1. Anchors drafted by AI; student review is open. The worked examples are illustrative and invented to explain the levels: not real ideas, evidence or human labels, and not training data.",
  "rules": "wanted_skill_overlap is the share (0 to 1) of the profile's interests and wanted skills the work uses. Evidence is cards showing the technologies involved; without them, abstain.",
  "anchors": {
    "0": "Teaches nothing new and shows nothing for the student's goal.",
    "1": "Almost only repeats what the student already does well.",
    "2": "A little new practice, weakly related to the student's goal.",
    "3": "Some wanted skills and a presentable result.",
    "4": "Several wanted skills and a result that fits the student's goal.",
    "5": "Teaches skills the student wants and shows well on a CV: most wanted skills, a demonstrable result matching the goal."
  },
  "features": [
    "wanted_skill_overlap",
    "new_skill_count",
    "goal_match"
  ],
